# Copy to .env on the server and fill in real values.
PORT=3000
NODE_ENV=production

# Backend (same values as the project .env)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server-only — bypasses RLS. Required for Admin > User Management
# (create/reset/block accounts) and JARVIS. Get it from Supabase
# dashboard > Settings > API. Never expose this in the frontend build.
SUPABASE_SERVICE_ROLE_KEY=

# Token the tender scraper sends as the x-ingest-token header
TENDER_INGEST_TOKEN=

# JARVIS calls Lovable's AI gateway (ai.gateway.lovable.dev), not a
# provider directly — this keeps working after self-hosting as long as
# the key and its Lovable account stay active. Get it from Lovable
# project Settings > Secrets/API keys.
LOVABLE_API_KEY=
